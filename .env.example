PRICING_COPILOT_MODEL_NAME=gpt-4.1-mini
PRICING_COPILOT_REQUEST_TIMEOUT_SECONDS=30
PRICING_COPILOT_MAX_WORKFLOW_SECONDS=90
PRICING_COPILOT_TOOL_TIMEOUT_SECONDS=5
PRICING_COPILOT_MAX_AGENT_TURNS=6
PRICING_COPILOT_MAX_TOOL_CALLS_PER_AGENT=4
PRICING_COPILOT_MAX_RETRIES=1
PRICING_COPILOT_LOCAL_TRACING_ENABLED=true
PRICING_COPILOT_AGENTS_SDK_TRACING_ENABLED=true
PRICING_COPILOT_TRACE_DIRECTORY=var/traces
PRICING_COPILOT_POLICY__MAX_PRICE_MOVEMENT_PCT=5.0
PRICING_COPILOT_POLICY__MAX_EVIDENCE_AGE_DAYS=120
PRICING_COPILOT_POLICY__MINIMUM_SOURCE_TYPES=3
PRICING_COPILOT_POLICY__REQUIRE_CLAIMS_EVIDENCE=true
PRICING_COPILOT_POLICY__REQUIRE_CONVERSION_EVIDENCE=true
PRICING_COPILOT_POLICY__REQUIRE_HUMAN_APPROVAL=true
PRICING_COPILOT_POLICY__PROHIBIT_CUSTOMER_LEVEL_ACTIONS=true

# Configure current, approved model pricing to enable non-zero cost estimates in traces.
PRICING_COPILOT_COST__INPUT_COST_PER_MILLION_TOKENS_GBP=0
PRICING_COPILOT_COST__OUTPUT_COST_PER_MILLION_TOKENS_GBP=0

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.4
